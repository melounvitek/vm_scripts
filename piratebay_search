#!/usr/bin/env bash
# deps: curl, jq, numfmt (coreutils)

set -euo pipefail
if [ $# -lt 1 ]; then
  echo "Usage: $0 <search terms...>" >&2
  exit 1
fi

query="$(printf '%s' "$*" | jq -sRr @uri)"
url="https://apibay.org/q.php?q=${query}&cat="

curl -sL "$url" \
| jq -r '
  sort_by((.seeders|tonumber)) | reverse | .[:5] |
  .[] 
  | select(.info_hash != null and .info_hash != "")
  | [.seeders, .name, .info_hash, (.name|@uri), .size]
  | @tsv
' \
| while IFS=$'\t' read -r seeders name hash dn size; do
    hr_size=$(numfmt --to=iec --suffix=B "$size")
    echo "$seeders seeders | $hr_size | $name"
    echo "magnet:?xt=urn:btih:$hash&dn=$dn&xl=$size"
    echo
  done
